# Supabase public browser/server-session configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase server-only administration (staff invitations / webhook processing)
SUPABASE_SECRET_KEY=sb_secret_...

# Canonical application URL used in Auth and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gym access credentials: generate at least 32 random characters and keep server-only
CARD_TOKEN_HMAC_SECRET=

# SaaS subscription billing (optional until you enable paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Protects scheduled maintenance routes. Generate a long random server-only value.
CRON_SECRET=
